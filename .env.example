# Stellar AgentKit — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Required ─────────────────────────────────────────────────────────────────
# Target Stellar network
STELLAR_NETWORK=testnet

# ─── Optional: Payment Signing ────────────────────────────────────────────────
# Stellar secret key used when the agent needs to sign and submit payments.
# Leave unset if you only need read-only tools (balance checks, TOML resolution).
# STELLAR_SECRET_KEY=S...

# ─── Optional: Custom Endpoints ───────────────────────────────────────────────
# Override the default Horizon RPC URL for testnet
# HORIZON_RPC_URL=https://horizon-testnet.stellar.org

# For mainnet, set STELLAR_NETWORK=mainnet and optionally:
# HORIZON_RPC_URL=https://horizon.stellar.org
